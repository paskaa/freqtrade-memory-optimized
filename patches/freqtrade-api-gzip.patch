 docs/rest-api.md                         |  7 ++++
 freqtrade/config_schema/config_schema.py |  4 +++
 freqtrade/rpc/api_server/webserver.py    |  9 +++++
 tests/rpc/test_rpc_apiserver.py          | 45 ++++++++++++++++++++++++
 5 files changed, 66 insertions(+)

