     assert resp["profit_pct"] == 0.5
 
 
+def test_api_gzip_response(botclient, mocker, fee, markets):
+    ftbot, client = botclient
+    mocker.patch.multiple(EXMS, markets=PropertyMock(return_value=markets))
+    create_mock_trades(fee, is_short=False)
+    Trade.session.flush()
+
+    rc = client_get(client, f"{BASE_URI}/trades?limit=500")
+    assert_response(rc)
+    # The response is larger than the gzip minimum size, so it should be compressed
+    assert len(rc.content) > 1024
+    assert rc.headers.get("content-encoding") == "gzip"
+
+
+def test_api_gzip_disabled(default_conf, mocker, fee, markets):
+    default_conf["runmode"] = RunMode.DRY_RUN
+    default_conf["api_server"] = {
+        "enabled": True,
+        "listen_ip_address": "127.0.0.1",
+        "listen_port": 8080,
+        "CORS_origins": ["http://example.com"],
+        "jwt_secret_key": _JWT_SECRET_KEY,
+        "username": _TEST_USER,
+        "password": _TEST_PASS,
+        "ws_token": _TEST_WS_TOKEN,
+        "enable_gzip": False,
+    }
+    ftbot = get_patched_freqtradebot(mocker, default_conf)
+    mocker.patch.multiple(EXMS, markets=PropertyMock(return_value=markets))
+    mocker.patch("freqtrade.rpc.api_server.webserver.ApiServer.start_api", MagicMock())
+    apiserver = ApiServer(default_conf)
+    apiserver.add_rpc_handler(RPC(ftbot))
+    try:
+        with TestClient(apiserver.app) as client:
+            create_mock_trades(fee, is_short=False)
+            Trade.session.flush()
+
+            rc = client_get(client, f"{BASE_URI}/trades?limit=500")
+            assert_response(rc)
+            assert len(rc.content) > 1024
+            assert rc.headers.get("content-encoding") is None
+    finally:
+        apiserver.cleanup()
+        ApiServer.shutdown()
+
+
